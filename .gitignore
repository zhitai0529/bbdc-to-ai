!/README.md
!/CHANGELOG.md
!/LICENSE
!/config.example.yaml
!/rules.yaml
!/requirements.txt
!/requirements-desktop.txt
!/requirements-build.txt
!/setup.bat
!/export_daily.bat
!/run_sniffer.bat
!/restore_mumu_network.bat
!/build_exe.bat
!/src/
/src/*
!/src/*.py
!/tests/
/tests/*
!/tests/*.py
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/synthetic_response.json
!/examples/
/examples/*
!/examples/synthetic_review.md
!/packaging/
/packaging/*
!/packaging/*.py
!/packaging/*.spec
!/packaging/*.ico
!/packaging/*.ps1
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/windows.yml
